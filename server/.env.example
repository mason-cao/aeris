# Database
DATABASE_URL=postgresql+asyncpg://aeris:aeris@localhost:5432/aeris
DATABASE_URL_SYNC=postgresql://aeris:aeris@localhost:5432/aeris

# Air Quality APIs
OPENAQ_API_KEY=
PURPLEAIR_API_KEY=
OPENAQ_MAX_READING_AGE_S=21600

# EPA AQS historical ground chemistry (backfill-only)
AQS_EMAIL=
AQS_API_KEY=

# Weather
OPENWEATHER_API_KEY=

# Copernicus Data Space (Sentinel-5P)
CDSE_USERNAME=
CDSE_PASSWORD=

# LLM (for cloud comparison only; local uses Ollama at localhost:11434)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# App
AERIS_ENV=development
AERIS_LOG_LEVEL=INFO
AERIS_TARGET_LAT=29.7604
AERIS_TARGET_LON=-95.3698
AERIS_TARGET_RADIUS_KM=50
