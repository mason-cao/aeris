# Point the AERIS pipeline at the local Timescale analysis DB (Option A).
# Copy to .env.analysis and load it before running detection/enrichment/harness:
#   set -a && source deploy/analysis/.env.analysis && set +a
# (The Acer's own .env, with its sqlite DATABASE_URL, is untouched.)

DATABASE_URL=postgresql+asyncpg://aeris:aeris@localhost:5433/aeris
DATABASE_URL_SYNC=postgresql://aeris:aeris@localhost:5433/aeris
AERIS_ENV=production
