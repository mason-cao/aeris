# Database
DATABASE_URL=postgresql+asyncpg://aeris:aeris@localhost:5432/aeris

# Air Quality APIs
OPENAQ_API_KEY=

# Weather
OPENWEATHER_API_KEY=

# NASA / Satellite
NASA_EARTHDATA_TOKEN=
CDSE_USERNAME=
CDSE_PASSWORD=

# Mapping (frontend uses this via API proxy)
MAPBOX_TOKEN=

# LLM (for cloud comparison only; local uses Ollama at localhost:11434)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# App
AERIS_ENV=development
AERIS_LOG_LEVEL=INFO
AERIS_TARGET_LAT=29.7604
AERIS_TARGET_LON=-95.3698
AERIS_TARGET_RADIUS_KM=50
